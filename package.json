{
  "name": "sei-protocolistas",
  "version": "0.2.17",
  "description": "Extensão de produtividade para protocolistas no Sistema Eletrônico de Informações - SEI",
  "main": "index.js",
  "repository": "https://github.com/thiagonevesrj/sei-protocolistas.git",
  "author": "Thiago Neves e colaboradores do SEI++",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "webextensions": true,
      "jquery": true
    },
    "extends": [
      "standard",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 12
    },
    "rules": {},
    "ignorePatterns": [
      "lib/*",
      "cs_modules/core.d_idle/*"
    ],
    "globals": {
      "browser": "readonly",
      "currentBrowser": "readonly"
    }
  },
  "scripts": {
    "start": "web-ext run --keep-profile-changes --firefox-profile=seipp-profile-testes",
    "lint": "bunx eslint .",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.1"
  }
}
